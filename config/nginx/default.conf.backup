# Default server: SPA with the base config (localhost, direct IP, unknown hosts)
server {
    listen 80 default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    location = /config.json {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location /socket.io/ {
        proxy_pass http://192.168.1.75:8444/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    location /mototaxi {
        try_files $uri $uri/ /index.html;
    }

    include /etc/nginx/conf.d/rtm-snippet;
}

# Landing portal with links to all apps
server {
    listen 80;
    server_name yucatanmx.com www.yucatanmx.com;
    root /usr/share/nginx/html;
    index landing/index.html;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    location = /config.json {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location = /manifest.json {
        alias /usr/share/nginx/html/manifest.json;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location /socket.io/ {
        proxy_pass http://192.168.1.75:8444/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    location /mototaxi {
        try_files $uri $uri/ /index.html;
    }

    include /etc/nginx/conf.d/rtm-snippet;
}

